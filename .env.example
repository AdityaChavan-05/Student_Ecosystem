# ---------------------------------------------------------------------------
# Student Ecosystem — environment template
# Copy to `.env` (never commit the real file) and fill in what you need.
# Every value has a working default: with no `.env` at all the app still runs,
# using local SQLite, curated feeds and a deterministic local summarizer.
# ---------------------------------------------------------------------------

# Flask ---------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Required for stable sessions in production; a random per-process key is used
# locally when this is empty. Gmail OAuth endpoints return 503 without it.
SECRET_KEY=
FLASK_DEBUG=false
PORT=5000

# Storage -------------------------------------------------------------------
# Local-first SQLite. The directory is created automatically.
DATABASE_PATH=instance/student_ecosystem.db
# On read-only serverless hosts such as Vercel use a writable path, remembering
# that /tmp storage is ephemeral and not shared between instances:
# DATABASE_PATH=/tmp/student_ecosystem.db

# AI summaries (optional) ---------------------------------------------------
# Leave empty to use the built-in extractive summarizer.
# A key can be created at https://aistudio.google.com/apikey
AI_API_KEY=
# AI_API_KEY falls back to GEMINI_API_KEY if provided instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
AI_TIMEOUT_SECONDS=40
AI_MAX_INPUT_CHARS=14000

# Campus feed ---------------------------------------------------------------
COLLEGE_WEBSITE_URL=https://mitwpu.edu.in/
COLLEGE_NAME=MIT World Peace University
COLLEGE_SHORT_NAME=MIT-WPU
COLLEGE_CITY=Pune, Maharashtra

# Feeds & caching -----------------------------------------------------------
REQUEST_TIMEOUT=12
NEWS_CACHE_MINUTES=30
# If Google/Bing throttle, reuse a cached feed up to this old (minutes).
NEWS_STALE_MAX_MINUTES=1440
# One bounded retry with jitter for transient 429/5xx responses on serverless.
NEWS_FETCH_ATTEMPTS=2
NEWS_RETRY_BASE_SECONDS=0.4
NEWS_RETRY_MAX_SECONDS=1.5
COLLEGE_CACHE_MINUTES=20
BRIEFING_CACHE_MINUTES=360
AI_CACHE_MINUTES=10080
SOCIAL_CACHE_MINUTES=30

# HTTP ----------------------------------------------------------------------
# Same-origin is the default. For a separate frontend, list explicit origins.
# Do not use `*` when the app is publicly reachable.
CORS_ORIGINS=

# Gmail OAuth ---------------------------------------------------------------
# Use the deployed HTTPS callback URL on Vercel. Token storage auto-falls back
# to a writable temp dir; a single global token is intended for a single user.
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
GMAIL_TOKEN_FILE=instance/gmail_token.json

# Official social sources (optional) ----------------------------------------
# Profile shortcuts only. No credentials are required and no posts are invented.
# Example: [{"label":"MIT-WPU LinkedIn","url":"https://www.linkedin.com/school/.../","platform":"linkedin"}]
SOCIAL_LINKS_JSON=

# LinkedIn Posts API — organisation page you administer (official API only).
# Requires r_organization_social and an admin/content role on that page.
# URN example: urn:li:organization:1234567 (numeric IDs are accepted too).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202601
LINKEDIN_AUTHOR_URNS=

# Instagram Graph API — professional account you own/manage. Personal accounts
# are not supported. Business Discovery requires INSTAGRAM_API_HOST=graph.facebook.com
# and a Facebook Login token with the right permissions; it is skipped otherwise.
# It reads public professional accounts only, never private profiles.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_HOST=graph.instagram.com
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_DISCOVERY_USERNAMES=
